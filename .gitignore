node_modules
dist
dist-ssr
*.local
.DS_Store
.vite
coverage

# Hemligheter — aldrig i git. Nyckel (AI_API_KEY, ev. ELEVENLABS_API_KEY) bor i
# gatewayns .env och ingenstans annars.
.env
.env.*
# ...men mallarna SKA spåras (inga hemligheter i dem — installern kopierar dem).
!.env.example
!server/.env.example
server/.env

# Firmware-hemligheter (WiFi/MQTT) — committa bara *.example.h.
firmware/*/src/config.h
firmware/*/config.h
firmware/arduino-ino/*/secrets.h
bestallning-erik/*/secrets.h

# Python
__pycache__
*.pyc

# Käll-/masterklippen (~74 MB, full bitrate) hålls UTANFÖR git — Josef har dem
# lokalt. De SLIMMADE, servade klippen i public/media/ (~41 MB, 576×1024) committas
# så drift får dem via git. Byt klipp = lägg ny master i assets/video/ + slimma
# om till public/media/.
assets/video/
